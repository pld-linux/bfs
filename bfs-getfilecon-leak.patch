---
 src/fsade.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/fsade.c b/src/fsade.c
index 3d4c8ba9..0c450c04 100644
--- a/src/fsade.c
+++ b/src/fsade.c
@@ -501,6 +501,8 @@ char *bfs_getfilecon(const struct BFTW *ftwbuf) {
 		ret = getfilecon(path, &con);
 	}
 
+	free_fake_at(ftwbuf, path);
+
 	if (ret >= 0) {
 		return con;
 	} else {
